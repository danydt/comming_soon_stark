# =============================================================================
# Fondation Stark Hold Solutions — variables d'environnement (web/)
# Copier ce fichier en « .env » pour le développement local. Ne JAMAIS committer .env.
# Sur Vercel : Project → Settings → Environment Variables (Production + Preview).
# Aucune de ces variables n'est exposée au navigateur, sauf celles préfixées NEXT_PUBLIC_.
# =============================================================================

# --- Application ---------------------------------------------------------------
# URL publique du site, sans « / » final.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Secret Payload (chiffrement des jetons). 32+ caractères aléatoires :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# --- Base de données : Supabase Postgres ------------------------------------------
# Supabase → bouton « Connect » → onglet « Connection string » → URI.
# Exécution (Vercel/serverless) : pooler Supavisor, mode TRANSACTION, port 6543.
# Hôte et préfixe (aws-0, aws-1…) : à copier depuis Supabase → Connect. Mot de passe URL-encodé (/ → %2F, @ → %40…).
#   postgresql://postgres.<ref>:<mot-de-passe>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
DATABASE_URI=
# Migrations (`pnpm migrate:prod`) : pooler, mode SESSION, port 5432.
#   postgresql://postgres.<ref>:<mot-de-passe>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
DATABASE_URI_MIGRATIONS=
# Connexions max par instance (le pooler mutualise). 3 convient à Vercel.
DATABASE_POOL_MAX=3
# Synchronisation automatique du schéma en développement (true par défaut). Mettre false
# pour travailler uniquement avec des migrations.
PAYLOAD_DB_PUSH=true

# --- Supabase (projet) --------------------------------------------------------------
# Supabase → Project Settings → API.
SUPABASE_URL=https://<ref>.supabase.co
# Clé publique « anon » : utilisée UNIQUEMENT par `pnpm check:supabase` (jamais côté client).
SUPABASE_ANON_KEY=

# --- Médias : Supabase Storage (API compatible S3) ----------------------------------
# Supabase → Storage → Settings → « S3 Connection » : endpoint + région ; « S3 Access Keys » : nouvelle clé.
# Laisser S3_ENDPOINT vide en dev pour stocker les fichiers dans web/media/ (interdit en production).
S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
S3_REGION=
S3_BUCKET=media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Facultatif : URL publique du bucket (par défaut <SUPABASE_URL>/storage/v1/object/public/<S3_BUCKET>).
S3_PUBLIC_URL=

# --- E-mail ---------------------------------------------------------------------------
# resend | smtp | console. Vide : Resend si RESEND_API_KEY est défini, SMTP si SMTP_HOST l'est,
# sinon « console » (les e-mails sont affichés dans les logs — développement).
EMAIL_PROVIDER=
EMAIL_FROM_ADDRESS=noreply@fondationstarkhold.org
EMAIL_FROM_NAME=Fondation Stark Hold Solutions
EMAIL_CONTACT_TO=contact@fondationstarkhold.org
# Resend (domaine fondationstarkhold.org à vérifier : enregistrements SPF/DKIM chez LWS).
RESEND_API_KEY=
# SMTP (alternative à Resend, ex. boîte LWS).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Premier administrateur (`pnpm seed:admin`) ------------------------------------
ADMIN_EMAIL=
# 12 caractères minimum.
ADMIN_PASSWORD=
ADMIN_NAME=Administrateur
